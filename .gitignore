# =============================================================================
# Robust Neural Control via Flat Minima - Pendubot (MATLAB + CasADi)
# =============================================================================

# --- Experiment results -------------------------------------------------------
# scripts/main.m writes one numbered folder per optimisation run. Only the three runs
# reported in the dissertation are versioned:
#   10 = FEP, 31 = Adam, 37 = Yama
robotics_result/robust_optimization/test_drive/results/*
!robotics_result/robust_optimization/test_drive/results/10/
!robotics_result/robust_optimization/test_drive/results/31/
!robotics_result/robust_optimization/test_drive/results/37/
# Files written straight into results/ by flag_mode = 1 (testing) runs
robotics_result/robust_optimization/test_drive/results/*.mat
robotics_result/robust_optimization/test_drive/results/*.png
robotics_result/robust_optimization/test_drive/results/*.fig
# Other configuration folders you may create next to test_drive/
robotics_result/robust_optimization/*/
!robotics_result/robust_optimization/test_drive/

# --- CasADi (install it separately; never commit the binaries) ----------------
casadi/
casadi-*/

# --- MATLAB -------------------------------------------------------------------
# Editor autosaves and backups
*.asv
*.m~
*.autosave
# Compiled MEX files
*.mex*
*.mexw64
*.mexa64
*.mexmaci64
*.mexmaca64
# Simulink / code generation caches
slprj/
sccprj/
codegen/
*.slxc
*.slx.r20*
*.mdl.r20*
# Generated by src/+model/generateModel.m in the current folder (matlabFunction output)
dD.m
# Kept from the original project .gitignore
dummyModelConf.asv
# Live-script / MATLAB Drive temporaries
*.mlx.autosave
.matlab/
# Profiler and crash output
profile_results/
matlab_crash_dump.*
hs_err_pid*.log
# Packaged toolbox / app builds
*.mltbx
*.mlappinstall
*.prj.bak

# --- Python helper tools (tools/) -------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# --- Office / OS / editor clutter ---------------------------------------------
~$*
*.tmp
.DS_Store
._*
Thumbs.db
desktop.ini
.vscode/
.idea/
